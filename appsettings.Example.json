{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=growydb;User Id=postgres;Password=<your-postgres-password>;"
  },
  "Google": { "ClientId": "<your-google-oauth-client-id>.apps.googleusercontent.com" },
  "Jwt": {
    "Secret": "<generate-with: openssl rand -base64 64>",
    "Issuer": "growy_server",
    "Audience": "growy_board",
    "ExpirationHours": 8
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "<your-smtp-username>",
    "Password": "<your-smtp-app-password>",
    "From": "<your-from-address>",
    "AdminEmail": "<your-admin-address>"
  }
}
